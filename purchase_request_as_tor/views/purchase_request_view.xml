<odoo>
    <record id="purchase_request_form_view_inherit" model="ir.ui.view">
        <field name="name">purchase.request.form.inherit</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="string">Term of Reference</attribute>
            </xpath>

            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>

            <field name="date_start" position="attributes">
                <attribute name="string">Start Date</attribute>
            </field>

            <field name="date_start" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="date_start" position="after">
                <field
                    name="date_end"
                    attrs="{'readonly': [('is_editable','=', False)]}"
                    required="1"
                />
            </field>

            <field name="origin" position="before">
                <field
                    name="project_name"
                    attrs="{'readonly': [('is_editable','=', False)]}"
                />
            </field>
            <field name="description" position="replace" />

            <field name="picking_type_id" position="attributes">
                <attribute name="string">Warehouse</attribute>
            </field>

            <xpath expr="//group[last()]" position="after">
                <group string="Description">
                    <field
                        name="description"
                        attrs="{'readonly': [('is_editable','=', False)]}"
                        nolabel="1"
                    />
                </group>
            </xpath>

        </field>
    </record>
</odoo>
